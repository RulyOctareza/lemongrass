<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  SPDX-License-Identifier: AGPL-3.0-only
  Copyright (C) 2026 The Lemongrass Authors

  The action names one exact path, since pkexec on any other path falls back to its generic password prompt. The path
  is where electron-builder's extraResources put the helper under the rpm's /opt prefix; Linux packages are x64 only.
-->
<policyconfig>
  <vendor>Lemongrass</vendor>

  <action id="com.lemongrass.app.lgrassroot">
    <description>Install or update a tool lemongrass needs</description>
    <message>Authentication is required to install or update a tool lemongrass needs</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/Lemongrass/resources/bin/linux-amd64/lgrassroot</annotate>
  </action>
</policyconfig>
